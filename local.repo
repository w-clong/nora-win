[local]
name=local
baseurl=http://192.168.10.240:4000/rpm/myrepo
enabled=1
exclude=redis-8* redis-7* jdk*21* jdk*17* php-*8.4* php-*8.5* gitlab*18* nodejs*24*
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[appstream]
name=appstream
baseurl=http://192.168.10.240:4000/rpm/appstream/
enabled=1
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[baseos]
name=baseos
baseurl=http://192.168.10.240:4000/rpm/baseos/
enabled=1
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[crb]
name=crb
baseurl=http://192.168.10.240:4000/rpm/crb/
enabled=0
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[epel]
name=epel
baseurl=http://192.168.10.240:4000/rpm/epel/
enabled=0
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9

[remi]
